{
  "name": "itp-itr-checklist",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "print:build": "vite-node web/scripts/build-static-print.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:api": "tsc --noEmit --project api/tsconfig.json",
    "api:dev": "wrangler dev --config api/wrangler.toml",
    "db:migrate:local": "wrangler d1 migrations apply itp-itr --local --config api/wrangler.toml"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "hono": "^4.6.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@testing-library/jest-dom": "^6.6.3",
    "fake-indexeddb": "^6.0.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^3.90.0"
  }
}
